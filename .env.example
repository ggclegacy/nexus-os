# Vercel's Turso Marketplace integration supplies both values automatically.
# For a manually created Turso database, copy its URL and token here.
TURSO_DATABASE_URL=libsql://your-database-name-your-account.turso.io
TURSO_AUTH_TOKEN=your-database-auth-token

# Required for any non-local deployment. Use a long, unique password.
NEXUS_ACCESS_USERNAME=nexus
NEXUS_ACCESS_PASSWORD=replace-with-a-long-random-password

# Optional on Vercel; recommended for canonical social-preview URLs elsewhere.
NEXT_PUBLIC_SITE_URL=https://your-private-nexus-domain.example

# Optional Phase 3 Google Calendar connection. Configure a Google OAuth web
# client with this callback:
# https://your-domain.example/api/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret

# Required with Google Calendar. Generate distinct values and store them only
# in server environment variables:
# openssl rand -base64 48
NEXUS_OAUTH_STATE_SECRET=replace-with-a-long-random-state-secret
# openssl rand -base64 32
NEXUS_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional Atlas Calendar language layer. Without this key, Calendar uses its
# deterministic capture, availability, search, briefs, planning, and insights.
OPENAI_API_KEY=your-openai-api-key
NEXUS_ATLAS_MODEL=gpt-5.6-sol
