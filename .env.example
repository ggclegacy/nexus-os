# Vercel's Turso Marketplace integration supplies both values automatically.
# For a manually created Turso database, copy its URL and token here.
TURSO_DATABASE_URL=libsql://your-database-name-your-account.turso.io
TURSO_AUTH_TOKEN=your-database-auth-token

# Required for any non-local deployment. Use a long, unique password.
NEXUS_ACCESS_USERNAME=nexus
NEXUS_ACCESS_PASSWORD=replace-with-a-long-random-password

# Optional on Vercel; recommended for canonical social-preview URLs elsewhere.
NEXT_PUBLIC_SITE_URL=https://your-private-nexus-domain.example
